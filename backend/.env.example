# Copy to .env and fill in real values. Never commit .env.

# Port the API server listens on
PORT=5000
# Origin allowed for CORS (the Next.js frontend)
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string (database name goes in the path)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/abharanam?retryWrites=true&w=majority"

# AWS S3 for product image uploads
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_BUCKET="abharanam"

# 64-hex-char random secret for signing auth JWTs
JWT_SECRET=""

# Seed credentials for the initial admin account (used by `npm run seed`)
ADMIN_EMAIL="admin@abharanam.com"
ADMIN_PASSWORD=""

# WhatsApp number that receives order details (country code + number, no +)
WHATSAPP_NUMBER="917558083325"
