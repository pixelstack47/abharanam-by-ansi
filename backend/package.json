{
  "name": "abharanam-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone REST API server for the Abharanam by Ansi storefront — MongoDB, JWT auth, S3 uploads, WhatsApp order handoff.",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "seed": "node --env-file=.env src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "mongoose": "^8.9.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
